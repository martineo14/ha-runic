  "options": {
    "step": {
      "init": {
        "title": "Opzioni Runic.io",
        "description": "Lo stream in tempo reale riceve gli avvisi senza un URL pubblico; richiede un endpoint “Real-time stream” nel portale Runic. La sincronizzazione delle zone copia le tue zone di Home Assistant (non quelle passive) in Runic come punti di interesse, così Runic genera gli avvisi di entrata e uscita. Modifica solo i punti di interesse che ha creato. Con un'email crea anche le regole di avviso di entrata e uscita per tutti i veicoli (Runic richiede un'email per ogni regola).",
        "data": {
          "stream": "Usa lo stream di avvisi in tempo reale",
          "sync_zones": "Sincronizza le zone di Home Assistant con i punti di interesse Runic",
          "zone_alert_email": "Email per le notifiche di Runic (crea le regole di entrata e uscita)"
        }
      }
    },
    "error": {
      "invalid_email": "Inserisci un indirizzo email valido oppure lascia vuoto."
    }
